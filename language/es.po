msgid "The item %s is retired in Omeka but current in the release."
msgstr "La ficha %s está retirada en Omeka pero vigente en la versión."

#: src/Admin/ReportErrors.php:39
#, php-format
msgid "Several items of the curriculum item set have the identifier %s."
msgstr "Varias fichas del conjunto del currículo tienen el identificador %s."

#: src/Admin/ReportErrors.php:44
