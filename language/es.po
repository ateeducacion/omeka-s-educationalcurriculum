msgstr "Las cargas aplicadas y las que están en curso no se pueden descartar."

#: src/Admin/ReportErrors.php:24
#, php-format
msgid "The item %s is in the curriculum item set but not in the release."
msgstr "La ficha %s está en el conjunto del currículo pero no en la versión."

