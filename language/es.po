msgstr "Una ficha del conjunto del currículo no tiene un dcterms:identifier literal."

#: src/Admin/ReportErrors.php:49
#, php-format
msgid "The node %s links through %s to %s, which is not in the release."
msgstr "El nodo %s enlaza mediante %s con %s, que no está en la versión."

#: src/Admin/ReportErrors.php:54
#, php-format
msgid "The new cur.ttl removes %s, which items use."
msgstr "El nuevo cur.ttl elimina %s, que usan las fichas."

#: src/Admin/ReportErrors.php:59
#, php-format
msgid "The release uses %s, which its cur.ttl does not define."
msgstr "La versión usa %s, que su cur.ttl no define."

