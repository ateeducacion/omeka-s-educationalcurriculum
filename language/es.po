msgstr "El fichero de suma de comprobación debe contener «<sha256>  curriculo.json»."

#: src/Release/Reader.php:67
msgid "The sha256 checksum does not match curriculo.json."
msgstr "La suma sha256 no coincide con curriculo.json."

